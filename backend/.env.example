# =============================================================================
# BitwiseHide Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_NAME=BitwiseHide
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# --- Server ---
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=true

# --- Database (PostgreSQL) ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://bitwisehide:bitwisehide_secret@localhost:5432/bitwisehide
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- File Storage ---
STORAGE_PATH=./storage
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_FORMATS=png,bmp,tiff

# --- JWT Authentication ---
JWT_SECRET_KEY=dev-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET_KEY=dev-refresh-secret-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
