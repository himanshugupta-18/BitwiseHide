# =============================================================================
# BitwiseHide — Git Ignore Rules
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/

# --- Virtual Environments ---
.venv/
venv/
env/

# --- uv ---
.uv/

# --- Environment ---
.env
.env.*
!.env.example

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Testing ---
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# --- Docker ---
docker-compose.override.yml

# --- Storage ---
storage/
*.png
*.bmp
*.tiff

# --- Logs ---
*.log

# --- Alembic ---
# Keep versions/ tracked but ignore auto-generated stamps
